# redirects.caddy — GENERATED by omeka-to-hugo. Do not edit by hand.
#
# Legacy Omeka Classic path -> native Hugo path (301). Deterministic across
# re-runs. Imported into the site's Caddy fragment at deploy time.
#
# Caddy `map` keys on {path} only, so legacy query-string variants collapse to
# their base-path target: e.g. /items/show/5?output=dcmes-xml -> /items/5/,
# whose page links the retained DCMES XML at /items/5/index.dcmesxml.xml, and
# /items/browse?collection=9 -> /items/ (the collection page is /collections/9/,
# reachable from /collections/show/9). Per-item and per-collection moves are
# single regex keys (both slash variants + the optional .html wget suffix), not
# one line per record.
#
# /files/* -> object storage is handled by the fronting web server, not here
# (media URLs are emitted root-relative).
map {path} {redirect_target} {
  default ""
  ~^/items/show/([0-9]+)(?:\.html)?/?$  /items/${1}/
  ~^/collections/show/([0-9]+)(?:\.html)?/?$  /collections/${1}/
  /collections  /collections/
  /collections/browse  /collections/
  /collections/browse/  /collections/
  /items  /items/
  /items/browse  /items/
  /items/browse/  /items/
}
@hasRedirect expression `{redirect_target} != ""`
redir @hasRedirect {redirect_target} 301
